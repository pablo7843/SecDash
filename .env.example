# ── API KEYS ──────────────────────────────────────────
# Obtén tu key gratis en https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Obtén tu key gratis en https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ── SERVER ────────────────────────────────────────────
PORT=3000

# ── CORS ─────────────────────────────────────────────
# En desarrollo: * o http://localhost:3000
# En producción: URL exacta de tu frontend (ej: https://tu-app.koyeb.app)
ALLOWED_ORIGIN=*
